{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Confluent.Kafka": "Warning"
    }
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "Topic": "customer-transactions",
    "ClientId": "external-transaction-publisher"
  },
  "Publisher": {
    "Enabled": true,
    "IntervalSeconds": 10,
    "ChunkSize": 50,
    "DataFilePath": "Data/financial-transactions.json"
  }
}
