{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "PostgresConnectionString": "Host=localhost;Port=5432;Database=transaction_aggregation;Username=postgres;Password=postgres"
  },
  "Aggregation": {
    "ExpensiveComputationDelayMs": 1500,
    "DefaultCurrency": "ZAR"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "Topic": "customer-transactions",
    "ConsumerGroupId": "transaction-aggregation",
    "ClientId": "transaction-aggregation-api"
  }
}
