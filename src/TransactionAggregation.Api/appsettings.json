{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Confluent.Kafka": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "PostgresConnectionString": ""
  },
  "Aggregation": {
    "DefaultCurrency": "ZAR",
    "CacheTtlSeconds": 120
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "Topic": "customer-transactions",
    "ConsumerGroupId": "transaction-aggregation",
    "ClientId": "transaction-aggregation-api"
  },
  "Observability": {
    "Enabled": true,
    "PrometheusEnabled": true,
    "OtlpEndpoint": "",
    "OtlpProtocol": "grpc"
  },
  "Jwt": {
    "Issuer": "transaction-aggregation",
    "Audience": "transaction-aggregation-api",
    "SigningKey": "dev-only-change-me-transaction-aggregation-signing-key-32b",
    "ExpirationMinutes": 60
  },
  "ServiceAccount": {
    "Username": "",
    "PasswordHash": ""
  },
  "Cache": {
    "ValkeyConnectionString": "",
    "KeyPrefix": "txn-agg:"
  }
}
